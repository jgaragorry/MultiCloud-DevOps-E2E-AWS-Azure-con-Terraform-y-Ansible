# Configuración global
global:
  scrape_interval: 15s # Raspar cada 15 segundos

# Configuración de scrapeo (los objetivos a monitorear)
scrape_configs:
  # 1. Monitorearse a sí mismo (Prometheus)
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # 2. Monitorear los Node Exporters (nuestras VMs de AWS y Azure)
  - job_name: 'node_exporter'
    static_configs:
      - targets:
        # --- ¡MAGIA DE ANSIBLE! ---
        # Itera sobre los hosts, pero extrae su variable 'scrape_ip'
        {% for host in groups['targets'] %}
        - '{{ hostvars[host].scrape_ip }}:9100'
        {% endfor %}
